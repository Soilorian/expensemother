# Replace these before starting. Use a URL-safe database password.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
AUTH_SECRET=replace-with-at-least-32-random-secret-bytes
# For running Go directly instead of Compose:
DATABASE_URL=postgres://expense:replace-with-a-random-url-safe-password@localhost:5433/expensemother?sslmode=disable
HTTP_ADDR=:7008
RECEIPT_DIR=data/receipts
TESSERACT_BIN=tesseract
# Leave empty to run the API without the bot.
TELEGRAM_BOT_TOKEN=
# Telegram Login client ID from BotFather (website SSO).
TELEGRAM_CLIENT_ID=
WEB_APP_URL=
ALLOWED_ORIGINS=http://localhost:3000
